# L'inscription à la bêta. Les trois boutons de la vitrine descendent au
# formulaire de la scène finale, qui poste sur `/api/beta` — voir
# `src/app/api/beta/route.ts`.

# La clé secrète Resend. Elle n'est jamais préfixée `NEXT_PUBLIC_` : une clé
# d'envoi exposée au navigateur, c'est un compte qui expédie du courrier pour
# quelqu'un d'autre avant la fin de la semaine.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Le segment où atterrissent les inscrits, par son nom — celui qu'affiche
# Resend > Segments. C'est cette liste que les Broadcasts prendront pour cible
# le jour de l'ouverture. `rakorn-beta` est la valeur par défaut du code : on
# ne remplit cette ligne que pour en viser un autre.
RESEND_SEGMENT=rakorn-beta

# À ne remplir que pour court-circuiter la résolution par nom, qui coûte un
# appel au démarrage de chaque instance.
RESEND_SEGMENT_ID=

# L'expéditeur. Le domaine doit être vérifié dans Resend (SPF + DKIM en DNS),
# mais aucune boîte n'a besoin d'exister derrière cette adresse : vérifier un
# domaine d'envoi ne crée pas de messagerie.
RESEND_FROM=Rakorn <support@rakorn.fr>

# Où partent les réponses, puisque personne ne relève `support@`. Une simple
# redirection (Cloudflare Email Routing, gratuit) suffit ; à défaut, une
# adresse personnelle. Laisser vide n'est pas une faute — les réponses se
# perdent, voilà tout.
RESEND_REPLY_TO=

# La mesure d'audience Google. Publique par nature — elle part dans le
# navigateur — d'où le préfixe. Absente, rien n'est chargé ; hors production,
# rien n'est chargé non plus (voir `src/components/analytics.tsx`).
NEXT_PUBLIC_GA_ID=G-KJHTXL8ZNX
